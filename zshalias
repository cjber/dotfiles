# Mosh on LAN is instant anyway — disable local-echo prediction so the
# predictor can't double-render keystrokes when fast-syntax-highlighting /
# autosuggestions rewrite the line under it.
alias mn='mosh --predict=never nuc'

# mosh into the NUC and land in a fresh tmux window cwd'd to your local
# $PWD (mirrored). No auto-launched claude — `exit` closes the window.
mcc() {
  local cwd="${1:-$PWD}"
  local name="${cwd##*/}"
  ssh nuc bash <<BASH
    export PATH="\$HOME/.local/bin:\$PATH"
    if tmux has-session -t main 2>/dev/null; then
      tmux new-window -t main -n '$name' -c '$cwd'
    else
      tmux new-session -d -s main -n '$name' -c '$cwd'
    fi
BASH
  mosh --predict=never nuc
}
{{/if}}
