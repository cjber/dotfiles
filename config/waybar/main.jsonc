{
    // Ultrawide (DP-1), top edge. Paired with columns.jsonc, which stacks a
    // second layer directly underneath for the column indicator.
    //
    // This bar carries only modules you act on: things you click, or that
    // change state and want your attention. Everything you merely glance at
    // -- cpu, memory, gpu, disk, temperature, tailscale, rclone, mouse
    // battery -- moved to side.jsonc on the vertical monitor, which is always
    // in peripheral vision and had a nearly empty bar. That halves the text
    // on the ultrawide without losing a single reading.
    "layer": "top",
    "position": "top",
    "output": "DP-1",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 0,
    // Pin modules-center to the true centre of the bar rather than letting it
    // float between the left and right groups, which have very different
    // widths on a 3440px display.
    "fixed-center": true,
    "modules-left": ["clock", "custom/keyboard-mode"],
    // Centre stays deliberately quiet: just where you are, and what's on the
    // tape. System metrics moved right so the centre reads at a glance.
    "modules-center": ["custom/ws1", "custom/ws2", "custom/ws3"],
    "modules-right": [
        "custom/tv-status",
        "tray",
        "network#ethernet",
        "network#wifi",
        "bluetooth",
        "custom/updates",
        "pulseaudio"
    ],

    // Workspace buttons. waybar's own hyprland/workspaces renders fine but its
    // clicks are dead on Hyprland 0.56 -- v0.15.0 still sends the hyprlang-era
    // `dispatch workspace N`, which a Lua-only Hyprland rejects. These use the
    // Lua dispatch form, so clicking works again.
    "custom/ws1": {
        "exec": "$HOME/.config/waybar/ws-button.sh 1",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
    },
    "custom/ws2": {
        "exec": "$HOME/.config/waybar/ws-button.sh 2",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"
    },
    "custom/ws3": {
        "exec": "$HOME/.config/waybar/ws-button.sh 3",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'"
    },

    // The column indicator lives on the second bar layer (columns.jsonc), so
    // it and the workspace numbers can each be centred independently.
    "custom/keyboard-mode": {
        "exec": "~/.config/waybar/keyboard-mode.sh",
        "return-type": "json",
        "signal": 12
    },

    "network#ethernet": {
        "interface": "eno1",
        "interval": 5,
        "format-ethernet": "↑{bandwidthUpBits:>} ↓{bandwidthDownBits:>}",
        "format-disconnected": "",
        "tooltip-format-ethernet": "{ifname} {ipaddr}/{cidr} via {gwaddr}",
        "tooltip-format-disconnected": "Ethernet disconnected",
        "max-length": 50
    },
    "network#wifi": {
        "interface": "wlan0",
        "interval": 5,
        "format-wifi": "{essid} ({signalStrength}%)",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "WiFi disconnected",
        "on-click": "kitty -e iwctl station wlan0 get-networks",
        "max-length": 50
    },
    // waybar hides a module whose formatted output is empty, so the
    // conditional modules below simply render nothing when they have nothing
    // to say. The count has to move into `exec` rather than `format`: with
    // "{} updates" as the format, a zero-length exec output still formats to
    // " updates" -- non-empty, so it would keep its slot on the bar.
    "custom/updates": {
        "format": "{}",
        "interval": 600,
        "exec": "n=$(checkupdates 2>/dev/null | wc -l); [ \"$n\" -gt 0 ] && printf '%s updates' \"$n\"; true",
        "on-click": "kitty -e sudo pacman -Syu",
        "signal": 8
    },
    "tray": {
        "icon-size": 13,
        "spacing": 10
    },
    "clock": {
        "timezone": "Europe/London",
        "format": "{:%R  %d/%m}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "pulseaudio": {
        "format": "vol {volume}%",
        "tooltip": false,
        "format-muted": "muted",
        "scroll-step": 5
    },
    "custom/tv-status": {
        "exec": "~/.config/waybar/tv-status.sh",
        "format": "{}",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/scripts/tv-toggle"
    },
    "bluetooth": {
        "format": "",
        "format-off": "",
        "format-disabled": "",
        "format-connected": "bt on",
        "format-connected-battery": "bt {device_battery_percentage}%",
        "tooltip-format": "bluetooth on",
        "tooltip-format-off": "bluetooth off",
        "tooltip-format-connected": "{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%",
        "on-click": "kitty -e bluetoothctl"
    }
}
