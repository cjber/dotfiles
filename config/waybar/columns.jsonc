{
    // Second bar layer on the ultrawide, stacked directly under main.jsonc.
    // Waybar has no multi-row bar, so "two layers" means two layer-shell
    // surfaces. Both are exclusive and top-anchored, so the compositor stacks
    // them automatically -- an explicit margin-top double-counts against the
    // exclusive zone and pushes the pair down the screen.
    //
    // Splitting them lets the workspace numbers and the column indicator each
    // be centred independently -- in a single bar they would share one centre
    // group and sit side by side, off-centre from each other.
    "name": "columns",
    "layer": "top",
    "position": "top",
    "output": "DP-1",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 0,
    "fixed-center": true,
    "modules-left": [],
    "modules-center": ["custom/columns"],
    "modules-right": [],

    "custom/columns": {
        "exec": "$HOME/.config/waybar/hypr-columns.sh",
        "return-type": "json",
        "escape": false,
        "on-click": "hyprctl dispatch 'hl.dsp.layout(\"fit all\")'",
        "on-click-right": "hyprctl dispatch 'hl.dsp.layout(\"colresize all 0.333\")'"
    }
}
