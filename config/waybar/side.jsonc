{
    // Vertical BenQ (DP-2), bottom edge.
    //
    // Only three modules are on this bar. It previously carried definitions
    // for eleven more (cpu, memory, disk, temperature, network, pulseaudio,
    // tray, backlight, idle_inhibitor, updates, gpu-*, rclone) that were not
    // referenced by any modules list -- dead config, and the source of most of
    // the Nerd Font private-use glyphs in the setup. Removed.
    "layer": "top",
    "position": "bottom",
    "output": "DP-2",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 0,
    "fixed-center": true,
    "modules-left": ["clock"],
    "modules-center": ["custom/keyboard-mode"],
    "modules-right": ["custom/weather"],

    "custom/keyboard-mode": {
        "exec": "~/.config/waybar/keyboard-mode.sh",
        "return-type": "json",
        "signal": 12
    },

    "clock": {
        "timezone": "Europe/London",
        "format": "{:%R  %d/%m}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/weather": {
        "format": "{}°",
        "tooltip": true,
        "interval": 3600,
        "exec": "wttrbar",
        "return-type": "json"
    }
}
