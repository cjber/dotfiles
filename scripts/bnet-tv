#!/usr/bin/env bash
# bnet-tv: restart Battle.net on the Hisense TV with sound on the soundbar, for
# playing from the sofa with a controller. Bound to SUPER+SHIFT+B.
#
# Battle.net is started from its desktop entry, exactly as rofi starts it, and
# opens on the TV because the TV's workspace is focused first. Its windows are
# left alone after that.
#
# Controller support is the GamePadEnable CVar, which wow-force-windowed sets
# when Lutris starts Battle.net.

set -uo pipefail

TV_WS=5
PREFIX=$HOME/Games/battlenet
WRAPPER='^lutris-wrapper: Battle\.net'
ENTRY=$(grep -l '^X-Bnet-Uid=battle.net$' "$HOME"/.local/share/applications/net.lutris.battlenet-*.desktop)

"$HOME/scripts/tv-toggle" on

# Stop the running session through its own wineserver, which ends every process
# in the prefix, a running game included. Signalling the launcher, the wrapper
# or the wineserver instead leaves the rest of the session running without a
# server, and the next Battle.net then starts broken beside it. A session whose
# wineserver has already died can only be killed outright.
for wrapper in $(pgrep -f "$WRAPPER"); do
  if server=$(pgrep -P "$wrapper" -x wineserver); then
    WINEPREFIX=$PREFIX "$(readlink "/proc/$server/exe")" -k
  else
    pkill -9 -P "$wrapper"
    kill "$wrapper"
  fi
done
for _ in $(seq 1 40); do
  pgrep -f "$WRAPPER" >/dev/null || break
  sleep 0.25
done

hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = $TV_WS }))" >/dev/null
gio launch "$ENTRY"
